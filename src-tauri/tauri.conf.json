{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "Arkiv",
    "version": "0.1.32"
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist",
    "devPath": "http://localhost:5173",
    "withGlobalTauri": true
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "fs": {
        "createDir": true,
        "copyFile": true,
        "readFile": true,
        "readDir": true,
        "removeDir": true,
        "writeFile": true,
        "scope": ["$HOME/**"]
      },
      "path": {
        "all": true
      },
      "dialog": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "it.marcellobianco.arkiv",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Arkiv",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ]
  }
}
